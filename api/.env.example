APP_NAME="Realtime Kanban"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# No sessions, queues or cache tables are needed: the API is stateless and
# broadcasts are sent synchronously (ShouldBroadcastNow).
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Origins allowed to call the API (comma-separated).
FRONTEND_URL=http://localhost:3000

# --- Laravel Reverb (WebSocket server) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=kanban
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
# Where Laravel publishes events to Reverb (server-to-server).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# What `php artisan reverb:start` binds to.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Origins allowed to open a WebSocket (comma-separated, * for any).
REVERB_ALLOWED_ORIGINS=*
